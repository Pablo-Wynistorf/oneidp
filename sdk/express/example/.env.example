# Copy to .env and fill in. `.env` is git-ignored; this file is not, so keep it
# free of real values.
#
# Anything already set in the environment takes precedence over this file.

# The ONEIDP instance. Also the `iss` claim of every token, so no trailing slash.
ONEIDP_ISSUER=https://oneidp.ch

# From Dashboard -> OIDC -> Applications (/oidc/apps).
ONEIDP_CLIENT_ID=
# Confidential clients only. Leave empty for a public client, which cannot refresh.
ONEIDP_CLIENT_SECRET=

# Seals the session cookie. Generate with: openssl rand -base64 32
# At least 32 characters, and identical across every instance of the app.
ONEIDP_COOKIE_SECRET=

# Public base URL of this app. The registered redirect URI must be
# <BASE_URL>/auth/callback, matching byte for byte.
BASE_URL=http://localhost:3000
PORT=3000
