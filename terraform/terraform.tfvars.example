###############################################################################
# Copy this file to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars
###############################################################################

# --- General -----------------------------------------------------------------
aws_region   = "eu-central-2"
project_name = "oneidp"

# --- Optional custom domain ---------------------------------------------------
# Leave both empty to use the auto-generated *.cloudfront.net domain.
# If you set domain_name you MUST provide an ACM certificate in us-east-1.
# domain_name         = "login.example.com"
# acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Optional explicit public URL override (ignored when domain_name is set).
# Leave empty to fall back to the CloudFront domain automatically.
# app_url = "https://login.example.com"

# --- Lambda tuning (optional) -------------------------------------------------
# lambda_runtime     = "nodejs22.x"
# lambda_memory_size = 512
# lambda_timeout     = 30
# log_retention_days = 14

# --- Data stores (required) ---------------------------------------------------
mongodb_uri = "mongodb+srv://user:password@cluster.mongodb.net/oneidp?retryWrites=true&w=majority"
redis_uri   = "redis://default:password@my-redis-host:6379"

# --- JWT signing keys ---------------------------------------------------------
# The RS256 keypair is always generated by Terraform (jwt-keys module).
# Optionally override the key size (defaults to 2048):
# jwt_rsa_bits = 2048

# --- Social login (optional) --------------------------------------------------
# github_client_id     = ""
# github_client_secret = ""
# google_client_id     = ""
# google_client_secret = ""

# --- Analytics (optional) -----------------------------------------------------
# google_analytics_tag_id = "G-XXXXXXXXXX"

# --- MailRift transactional email (optional) ----------------------------------
# mailrift_api_key      = "mrft_rest_..."
# mailrift_sender_email = "no-reply@example.com"
# mailrift_api_url      = "https://api.mailrift.io/v1"

# --- Monitoring (optional) ----------------------------------------------------
# dc_monitoring_webhook_url = "https://discord.com/api/webhooks/xxx/yyy"

###############################################################################
# Admin console
#
# Comma-separated addresses allowed into /admin. Admin rights cannot be granted
# from inside the app, and the account's email must be verified.
###############################################################################
admin_emails = "admin@onedns.ch"

###############################################################################
# Frontend delivery (optional, shown with their defaults)
###############################################################################
# frontend_cache_ttl_seconds = 60
